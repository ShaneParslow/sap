{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/src/sap-docs/tools/sync.py\" --hook 2>/dev/null || true",
            "statusMessage": "Syncing transcripts to sap-docs"
          }
        ]
      }
    ]
  },
  "env":{ 
    "RUSTUP_HOME": "/home/sparsl/.local/share/rustup",
    "CARGO_HOME": "/home/sparsl/.local/share/cargo"
  },
  "permissions": {
    "additionalDirectories": [
      "~/.local/share/cargo",
      "~/src/sap-docs"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "index.crates.io",
        "static.crates.io",
        "github.com"
      ]
    }
  }
}
